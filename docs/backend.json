
{
  "entities": {
    "Activity": {
      "title": "Activity",
      "type": "object",
      "description": "Mewakili aktivitas atau tugas yang ingin dilacak oleh pengguna.",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "title": { "type": "string" },
        "category": { "type": "string", "enum": ["Kesehatan", "Kerja", "Belajar", "Lainnya"] },
        "difficulty": { "type": "string", "enum": ["Easy", "Medium", "Hard"], "default": "Medium" },
        "durationMinutes": { "type": "number", "default": 25 },
        "targetValue": { "type": "number" },
        "deadline": { "type": "string", "format": "date" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "userId", "title"]
    },
    "ActivityLog": {
      "title": "ActivityLog",
      "type": "object",
      "description": "Catatan setiap kali aktivitas diselesaikan.",
      "properties": {
        "id": { "type": "string" },
        "activityId": { "type": "string" },
        "userId": { "type": "string" },
        "date": { "type": "string", "format": "date" },
        "difficulty": { "type": "string", "enum": ["Easy", "Medium", "Hard"] },
        "timestamp": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "activityId", "userId", "date"]
    },
    "Schedule": {
      "title": "Schedule",
      "type": "object",
      "description": "Jadwal harian, mingguan, atau bulanan pengguna.",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "title": { "type": "string" },
        "startTime": { "type": "string", "description": "Format HH:mm" },
        "endTime": { "type": "string", "description": "Format HH:mm" },
        "durationMinutes": { "type": "number" },
        "recurrence": { "type": "string", "enum": ["once", "daily", "weekly", "monthly"] },
        "daysOfWeek": { "type": "array", "items": { "type": "number" }, "description": "0-6 (Sun-Sat)" },
        "dayOfMonth": { "type": "number" },
        "specificDate": { "type": "string", "format": "date" },
        "status": { "type": "string", "enum": ["pending", "completed"] },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["userId", "title", "startTime", "endTime", "recurrence"]
    },
    "DailyStats": {
      "title": "DailyStats",
      "type": "object",
      "description": "Statistik harian seperti jumlah soal yang dikerjakan.",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "date": { "type": "string", "format": "date" },
        "questionsSolved": { "type": "number", "default": 0 }
      },
      "required": ["userId", "date"]
    },
    "Goal": {
      "title": "Goal",
      "type": "object",
      "description": "Target spesifik pengguna (misal: Belajar 20 jam).",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "title": { "type": "string" },
        "targetValue": { "type": "number" },
        "currentValue": { "type": "number", "default": 0 },
        "unit": { "type": "string", "enum": ["Jam", "Materi", "Episode"] },
        "deadline": { "type": "string", "format": "date" }
      },
      "required": ["userId", "title", "targetValue", "unit"]
    },
    "Report": {
      "title": "Report",
      "type": "object",
      "description": "Laporan error atau saran dari pengguna.",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "userEmail": { "type": "string" },
        "userName": { "type": "string" },
        "type": { "type": "string" },
        "subject": { "type": "string" },
        "message": { "type": "string" },
        "targetEmail": { "type": "string" },
        "timestamp": { "type": "string", "format": "date-time" }
      },
      "required": ["userId", "message", "type"]
    },
    "LeaderboardEntry": {
      "title": "LeaderboardEntry",
      "type": "object",
      "description": "Data peringkat pengguna.",
      "properties": {
        "userId": { "type": "string" },
        "username": { "type": "string" },
        "photoURL": { "type": "string" },
        "level": { "type": "number" },
        "totalActivities": { "type": "number" },
        "currentStreak": { "type": "number" },
        "isBot": { "type": "boolean", "default": false }
      },
      "required": ["username", "level", "totalActivities", "currentStreak"]
    }
  },
  "auth": {
    "providers": ["google.com"]
  },
  "firestore": {
    "structure": [
      {
        "path": "/users/{userId}/activities/{activityId}",
        "definition": {
          "entityName": "Activity",
          "schema": { "$ref": "#/backend/entities/Activity" },
          "description": "Koleksi aktivitas milik pengguna."
        }
      },
      {
        "path": "/users/{userId}/schedules/{scheduleId}",
        "definition": {
          "entityName": "Schedule",
          "schema": { "$ref": "#/backend/entities/Schedule" },
          "description": "Data jadwal pengguna."
        }
      },
      {
        "path": "/users/{userId}/logs/{logId}",
        "definition": {
          "entityName": "ActivityLog",
          "schema": { "$ref": "#/backend/entities/ActivityLog" },
          "description": "Log penyelesaian aktivitas."
        }
      },
      {
        "path": "/users/{userId}/dailyStats/{dateStr}",
        "definition": {
          "entityName": "DailyStats",
          "schema": { "$ref": "#/backend/entities/DailyStats" },
          "description": "Statistik harian seperti jumlah soal."
        }
      },
      {
        "path": "/users/{userId}/goals/{goalId}",
        "definition": {
          "entityName": "Goal",
          "schema": { "$ref": "#/backend/entities/Goal" },
          "description": "Target belajar spesifik."
        }
      },
      {
        "path": "/leaderboard/{entryId}",
        "definition": {
          "entityName": "LeaderboardEntry",
          "schema": { "$ref": "#/backend/entities/LeaderboardEntry" },
          "description": "Entri leaderboard global."
        }
      }
    ]
  }
}
